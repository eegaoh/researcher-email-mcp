{
  "name": "@eegaoh/researcher-email-mcp",
  "private": true,
  "version": "0.1.0",
  "mcpName": "io.github.eegaoh/researcher-email-mcp",
  "description": "Strictly read-only local IMAP and evidence-based peer-review tracker",
  "type": "module",
  "bin": {
    "researcher-email-mcp": "./dist/researcher/main.js"
  },
  "main": "./dist/researcher/main.js",
  "types": "./dist/researcher/main.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/researcher/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/researcher/main.js",
    "test:researcher": "vitest run --config vitest.researcher.ts",
    "test:researcher:integration": "vitest run --config vitest.researcher.ts --testNamePattern=integration",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/researcher --diagnostic-level=error",
    "privacy:check": "node scripts/check-publication.mjs",
    "lint:fix": "eslint src/ --fix",
    "format": "biome format --write src/",
    "format:check": "biome check src/",
    "test": "vitest run --config vitest.researcher.ts",
    "test:watch": "vitest --config vitest.researcher.ts",
    "test:coverage": "vitest run --config vitest.researcher.ts --coverage",
    "test:integration": "vitest run --config vitest.researcher.ts src/researcher/integration.test.ts",
    "test:all": "npm run typecheck && npm run build && npm test",
    "check": "biome check src/ && eslint src/",
    "report": "mkdir -p reports && biome check src/ --reporter=json > reports/biome.json 2>&1; eslint src/ -f json -o reports/eslint.json; actionlint -format '{{json .}}' > reports/actionlint.json 2>&1; pnpm test",
    "commit": "cog commit",
    "changelog": "cog changelog",
    "version:check": "cog check",
    "version:bump": "cog bump --auto",
    "version:bump:minor": "cog bump --minor",
    "version:bump:patch": "cog bump --patch",
    "version:log": "cog log",
    "prepare": "node -e \"console.log('Automatic Git hooks disabled in Researcher fork')\"",
    "hooks:install": "lefthook install --force",
    "hooks:uninstall": "lefthook uninstall",
    "docker:build": "docker build -t codefuturist/email-mcp .",
    "docker:run": "docker run --rm -i -v ~/.config/email-mcp:/home/node/.config/email-mcp:ro codefuturist/email-mcp",
    "docker:compose": "docker compose up",
    "docker:clean": "docker images --format '{{.Repository}}:{{.Tag}}' | grep email-mcp | xargs docker rmi -f 2>/dev/null; true",
    "docker:prune": "docker image prune -f && docker buildx prune -f",
    "release:check": "goreleaser check",
    "release:snapshot": "goreleaser release --snapshot --clean && pnpm docker:clean",
    "release:dry-run": "goreleaser release --skip=publish --clean && pnpm docker:clean",
    "prepublishOnly": "tsc -p tsconfig.build.json"
  },
  "keywords": [
    "email",
    "mcp",
    "imap",
    "smtp",
    "model-context-protocol",
    "mcp-server",
    "claude",
    "anthropic",
    "ai-tools",
    "llm",
    "nodejs"
  ],
  "author": {
    "name": "codefuturist",
    "url": "https://github.com/codefuturist"
  },
  "license": "LGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eegaoh/researcher-email-mcp.git"
  },
  "homepage": "https://github.com/eegaoh/researcher-email-mcp#readme",
  "bugs": {
    "url": "https://github.com/eegaoh/researcher-email-mcp/issues"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "csv-parse": "^7.0.3",
    "imapflow": "^1.2.9",
    "mailparser": "^3.9.39",
    "node-ical": "^0.25.2",
    "nodemailer": "^10.1.1",
    "smol-toml": "^1.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.2",
    "@eslint/compat": "^2.0.2",
    "@eslint/js": "^9.39.2",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^25.2.3",
    "@types/nodemailer": "^7.0.10",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.2",
    "eslint-config-airbnb-extended": "^3.0.1",
    "lefthook": "^2.1.1",
    "testcontainers": "^11.12.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.12.1"
}
